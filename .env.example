# inemaVOX2 - Variaveis de ambiente
# Copie este arquivo para .env e preencha os valores

# ============================================
# STT (Transcricao) - Engine configuravel
# ============================================
# Opcoes: groq | whisper-cpu | openai
# STT_ENGINE=groq

# Groq API Key (para STT e LLM)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (para STT via OpenAI Whisper)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo Whisper para CPU (tiny/small/medium)
# WHISPER_MODEL=small

# ============================================
# LLM (Analise de clipes, traducao cloud)
# ============================================
# Provider padrao: groq (mais rapido e barato)
# Opcoes: groq | openai | anthropic | deepseek | together | openrouter | custom
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# API keys para outros providers (opcional)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# HuggingFace Token (opcional - para diarizacao)
# ============================================
# 1. Crie conta em https://huggingface.co
# 2. Aceite termos em https://hf.co/pyannote/speaker-diarization-3.1
# 3. Gere token em https://hf.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
